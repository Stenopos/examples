// Safe params — primitive parameters are passed by copy, safe to reuse

func add(int32 a, int32 b) -> int32 {
    return a + b
}

func main() -> void {
    int32 x = 10
    int32 y = 20
    int32 z = add(x, y)
    int32 w = add(x, y)
    println("add(x, y) = {z}, add(x, y) = {w}, x and y are still {x} and {y}")
    println("int32 params are copyable")
}
