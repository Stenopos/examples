// Example: Modules and Imports
// Demonstrates: module declarations, pub / private / protected, every import
// form (one name, a list, `*`, a whole module, `as`), relative imports,
// re-exports and module-qualified names.
//
// A program may declare several modules in one file; a project usually keeps
// one module per file (src/app/models.sten holds `module app.models`).

// --- A library module ---

module app.models

// Public: visible to importers.
pub struct Config {
    pub str name
    pub int32 max_retries
    pub bool verbose
}

pub const int32 MAX_CONNECTIONS = 1024
pub const str VERSION = "1.0.0"

// Private by default: only this module sees it.
struct InternalState {
    int32 value
}

// Public function: part of the module's API.
pub func create_config(str name) -> Config {
    InternalState st = InternalState { value: 3 }
    return Config { name: name, max_retries: st.value, verbose: false }
}

// Private function: an implementation detail.
func validate_name(str name) -> bool {
    return name.len() > 0 && name.len() < 256
}

pub func is_valid(Config c) -> bool {
    return validate_name(c.name)
}

// Protected: open to the class, its subclasses and this module.
pub class BaseHandler {
    protected str prefix

    pub func handle(str input) -> str {
        return format_output(input)
    }

    protected func format_output(str input) -> str {
        return "{prefix}: {input}"       // a field, named without `this.`
    }
}

// --- A submodule, imported relatively ---

module app.models.helpers

import super.{Config}                    // app.models.Config

pub func describe(Config c) -> str {
    return "{c.name} (retries: {c.max_retries})"
}

// --- A facade that re-exports ---

module app.api

pub import app.models.{Config, create_config}
pub import app.models.helpers.{describe as summary}

// --- The program ---

module app

import app.api.*                         // Config, create_config, summary
import app.models.is_valid               // one name, without braces
import app.models.{BaseHandler, VERSION}
import app.models as models              // models.MAX_CONNECTIONS
import std.math                          // math.sqrt(...)
import std.collections.{range, sum_i32}

pub class LoudHandler : BaseHandler {
    pub func shout(str input) -> str {
        return this.format_output(input) + "!"
    }
}

func main() -> int32 {
    Config cfg = create_config("myapp")
    println("Config: {cfg.name}, valid: {is_valid(cfg)}")
    println(summary(cfg))

    float64 root = math.sqrt(16.0)
    println("sqrt(16) = {root}")
    println("max connections: {models.MAX_CONNECTIONS}")

    LoudHandler h = LoudHandler { prefix: "log" }
    println(h.shout("ready"))

    HashMap[str, int32] counts = map_new()
    counts.insert("hello", 1)
    counts.insert("world", 2)
    println("{counts.len()} words")
    println("1 + ... + 4 = {sum_i32(range(1, 5))}")

    println("Version: {VERSION}")
    return 0
}
