// Example: Structs (Advanced)
// Demonstrates: struct definition, methods, visibility, impl blocks, nested
// structs, generic structs
//
// Methods can be written inside the struct or in an `impl` block; they reach
// the value as `this`. Constructors are ordinary functions (static methods
// are not part of the language). `const` struct fields are not supported
// yet.

import std.math.{sqrt}

// Basic struct — fields are private by default. (8-bit integer types are
// reserved for later, so the channels are int32.)
struct Color {
    int32 r
    int32 g
    int32 b
    int32 a
}

// Struct with methods via an impl block
struct Vector2 {
    float64 x
    float64 y
}

// Constructors are plain functions
func vector2(float64 x, float64 y) -> Vector2 {
    return Vector2 { x: x, y: y }
}

func vector2_zero() -> Vector2 {
    return Vector2 { x: 0.0, y: 0.0 }
}

impl Vector2 {
    // Instance methods use 'this'
    func magnitude() -> float64 {
        return sqrt(this.x * this.x + this.y * this.y)
    }

    func normalize() -> Vector2 {
        float64 mag = this.magnitude()
        return Vector2 { x: this.x / mag, y: this.y / mag }
    }

    func add(Vector2 other) -> Vector2 {
        return Vector2 { x: this.x + other.x, y: this.y + other.y }
    }

    func dot(Vector2 other) -> float64 {
        return this.x * other.x + this.y * other.y
    }

    func scale(float64 factor) -> Vector2 {
        return Vector2 { x: this.x * factor, y: this.y * factor }
    }
}

// Struct with pub fields
struct Config {
    pub str name
    pub int32 max_retries
    bool debug  // private — only accessible within the module
}

// Nested structs
struct Address {
    str street
    str city
    str country
}

struct Person {
    str name
    int32 age
    Address address
}

// Struct with methods written inside it
struct Dimensions {
    float64 width
    float64 height

    func area() -> float64 {
        return this.width * this.height
    }
}

// Generic struct
struct KeyValue[K, V] {
    K key
    V value
}

func main() -> int32 {
    // Construction
    Color red = Color { r: 255, g: 0, b: 0, a: 255 }
    println("Red: ({red.r}, {red.g}, {red.b})")

    // Constructor functions
    Vector2 v1 = vector2(3.0, 4.0)
    Vector2 v2 = vector2(1.0, 2.0)
    Vector2 origin = vector2_zero()

    // Method calls
    println("Magnitude: {v1.magnitude()}")
    Vector2 sum = v1.add(v2)
    println("Sum: ({sum.x}, {sum.y})")
    println("Dot: {v1.dot(v2)}")
    Vector2 unit = v1.normalize()
    println("Normalized: ({unit.x}, {unit.y})")
    Vector2 big = v2.scale(10.0)
    println("Scaled: ({big.x}, {big.y}); origin: ({origin.x}, {origin.y})")

    Config cfg = Config { name: "app", max_retries: 3, debug: false }
    println("{cfg.name} retries {cfg.max_retries} times")

    // Nested struct
    Person alice = Person {
        name: "Alice",
        age: 30,
        address: Address {
            street: "123 Main St",
            city: "Springfield",
            country: "US"
        }
    }
    println("{alice.name} lives in {alice.address.city}")

    Dimensions box = Dimensions { width: 10.0, height: 5.0 }
    println("Area: {box.area()}")

    // Generic struct
    KeyValue[str, int32] kv = KeyValue { key: "age", value: 30 }
    println("{kv.key}: {kv.value}")

    return 0
}
