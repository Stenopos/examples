// Example: Generics
// Demonstrates: generic functions, generic structs, trait constraints, [T] syntax
//
// Generics are monomorphized: the compiler emits a specialized copy for each
// concrete type used, inferred from the arguments.

// Generic function — square brackets for type parameters
func max[T](T a, T b) -> T {
    if (a > b) {
        return a
    }
    return b
}

// Generic struct
struct Pair[A, B] {
    A first
    B second
}

func swap[A, B](Pair[A, B] p) -> Pair[B, A] {
    return Pair { first: p.second, second: p.first }
}

// Generic with trait constraint
trait Printable {
    func to_string() -> str
}

struct Celsius {
    float64 degrees
}

impl Printable for Celsius {
    func to_string() -> str {
        return "{this.degrees} C"
    }
}

func print_all[T: Printable](List[T] items) -> void {
    for (item in items) {
        println(item.to_string())
    }
}

// Generic container
struct Stack[T] {
    List[T] items

    func push(T item) -> void {
        this.items.push(item)
    }

    func pop() -> T? {
        if (this.items.len() == 0) {
            return null
        }
        return this.items.pop()
    }

    func peek() -> T? {
        if (this.items.len() == 0) {
            return null
        }
        return this.items.last()
    }

    func is_empty() -> bool {
        return this.items.len() == 0
    }
}

func main() -> int32 {
    // Generic function calls
    int32 m = max(10, 20)
    println("Max: {m}")

    float64 f = max(3.14, 2.71)
    println("Max: {f}")

    // Generic struct
    Pair[str, int32] p = Pair { first: "age", second: 30 }
    println("{p.first}: {p.second}")

    Pair[int32, str] swapped = swap(p)
    println("{swapped.first}: {swapped.second}")

    // Trait-constrained generic
    List[Celsius] temps = list_new()
    temps.push(Celsius { degrees: 21.5 })
    temps.push(Celsius { degrees: 0.0 })
    print_all(temps)

    // Generic container
    Stack[int32] s = Stack { items: list_new() }
    s.push(1)
    s.push(2)
    s.push(3)
    println("Peek: {s.peek() ?? 0}")

    while (!s.is_empty()) {
        int32? val = s.pop()
        if (val != null) {
            println("Popped: {val}")
        }
    }

    return 0
}
