// Example: Closures
// Demonstrates: lambda syntax, capture semantics, higher-order functions
//
// A lambda is written `|params| -> ReturnType { body }` and has the type
// `fn(parameter types)->return type`. It captures the variables it uses by
// copying their values into its own environment (value semantics), so a
// later change to the original is not seen by the closure.

import std.string.{join}

// Closure / lambda as a parameter
func apply(int32 x, fn(int32)->int32 f) -> int32 {
    return f(x)
}

// Higher-order functions
func map[T, U](List[T] items, fn(T)->U transform) -> List[U] {
    List[U] result = list_new()
    for (item in items) {
        result.push(transform(item))
    }
    return result
}

func filter[T](List[T] items, fn(T)->bool predicate) -> List[T] {
    List[T] result = list_new()
    for (item in items) {
        if (predicate(item)) {
            result.push(item)
        }
    }
    return result
}

func reduce[T, U](List[T] items, U initial, fn(U, T)->U accumulator) -> U {
    U result = initial
    for (item in items) {
        result = accumulator(result, item)
    }
    return result
}

func show(List[int32] xs) -> str {
    List[str] parts = xs.map(|x| -> str "{x}")
    return "[" + join(parts, ", ") + "]"
}

// Returning a closure that captured `n`
func make_adder(int32 n) -> fn(int32)->int32 {
    return |int32 x| -> int32 { return x + n }
}

func main() -> int32 {
    // Inline closure
    int32 doubled = apply(5, |int32 x| -> int32 { return x * 2 })
    println("Doubled: {doubled}")

    // Map
    List[int32] numbers = [1, 2, 3, 4, 5]
    List[int32] squares = map(numbers, |int32 x| -> int32 { return x * x })
    println("Squares: {show(squares)}")

    // Filter
    List[int32] evens = filter(numbers, |int32 x| -> bool { return x % 2 == 0 })
    println("Evens: {show(evens)}")

    // Reduce
    int32 sum = reduce(numbers, 0, |int32 acc, int32 x| -> int32 { return acc + x })
    println("Sum: {sum}")

    // Chaining
    int32 result = reduce(
        filter(
            map(numbers, |int32 x| -> int32 { return x * x }),
            |int32 x| -> bool { return x > 5 }),
        0,
        |int32 acc, int32 x| -> int32 { return acc + x })
    println("Sum of squares > 5: {result}")

    // Lists also have built-in map/filter/reduce methods
    println("Built-in: {numbers.map(|x| -> int32 x * 10).filter(|x| x > 20).reduce(0, |acc, x| acc + x)}")

    // Returned closure
    fn(int32)->int32 add5 = make_adder(5)
    println("10 + 5 = {add5(10)}")

    // Captures are copies: changing `base` afterwards does not affect the closure
    int32 base = 100
    fn(int32)->int32 offset = |int32 x| -> int32 { return x + base }
    base = 0
    println("offset(1) = {offset(1)} (base is now {base})")

    return 0
}
