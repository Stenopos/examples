// Example: Annotations
// Demonstrates: the built-in annotations and their usage
//
// Every annotation is checked: an unknown or misplaced one is a compile error,
// never silently ignored. `@packed`, `@aligned(N)` and `@opaque` are reserved
// and rejected until C-compatible layouts land, and annotations on struct
// fields are not supported yet; they are shown in comments below.

import std.string.{split, join}

// --- Function annotations ---

// Return values are must-use by default — a compile error if dropped.
// @ignore_discard lets callers drop this one.
@ignore_discard
func compute(int32 x) -> int32 {
    return x * x + 1
}

// Function never returns (it may not `return`; reaching its end aborts)
@no_return
func fatal_error(str message) -> void {
    eprintln("FATAL: {message}")
    fail(message)
}

// Hint: inline this function at call sites
@inline
func fast_add(int32 a, int32 b) -> int32 {
    return a + b
}

// Hint: this function is rarely called (error paths)
@cold
func handle_error(str msg) -> void {
    eprintln(msg)
}

// Hint: this function is called frequently (hot loop)
@hot
func process_item(int32 item) -> int32 {
    return item * 2
}

func process_v2(int32 x) -> int32 {
    return x
}

// Mark as deprecated with a message: callers get a warning
@deprecated("Use process_v2() instead")
func process(int32 x) -> int32 {
    return process_v2(x)
}

// --- Struct annotations ---

// No padding between fields — exact memory layout (1.0):
// @packed
// struct PackedHeader { ... }

// Align struct to N-byte boundary (1.0):
// @aligned(64)
// struct CacheLine { int64[8] data }

// C-compatible memory layout: fields laid out exactly as C does
@repr("C")
struct CStruct {
    int32 x
    int32 y
    float64 z
}

// Opaque type — internals hidden from other modules (1.0):
// @opaque
// struct Handle { ... }

// --- Security annotations ---

struct Password {
    str value
}

// Taint tracking: a source, a sanitizer and a sink
@tainted
func read_user_input() -> str {
    return "<b>hello</b>"
}

@sanitizer
func sanitize_html(str input) -> str {
    // Escape the characters that start and end a tag
    return join(split(join(split(input, "<"), "&lt;"), ">"), "&gt;")
}

@sink
func render(str html) -> void {
    // Compiler ensures only sanitized data reaches here
    println("render: {html}")
}

// --- Test annotation ---

// @test functions are run by `stenopos test` (on a file without `main`) or
// `tagma test`; a normal build leaves them out
@test
func test_compute() -> void {
    if (compute(3) != 10 || compute(0) != 1) {
        fail("compute")
    }
}

@test
func test_fast_add() -> void {
    if (fast_add(2, 3) != 5) {
        fail("fast_add")
    }
}

// --- Linker section ---

@section(".text.startup")
func early_init() -> void {
    // Placed in the .text.startup section of the binary
}

func main() -> int32 {
    int32 result = compute(5)
    println("Result: {result}")
    compute(6)                      // allowed: @ignore_discard

    // @inline — transparent to the user
    int32 sum = fast_add(10, 20)
    println("Sum: {sum}")
    println("Hot: {process_item(21)}")
    println("Deprecated: {process(7)}")

    // @repr("C") struct
    CStruct c = CStruct { x: 1, y: 2, z: 3.5 }
    println("CStruct: {c.x} {c.y} {c.z}")

    // @sensitive — the value is wiped when pw goes out of scope
    @sensitive Password pw = Password { value: "hunter2" }

    // Taint: sanitize before the sink
    render(sanitize_html(read_user_input()))

    early_init()
    if (result < 0) {
        handle_error("negative result")
        fatal_error("unreachable")
    }
    return 0
}
