// Example: Pattern Matching
// Demonstrates: match statements, enum matching, payload binding,
// exhaustiveness, several patterns sharing a result
//
// A `case` uses the colon form: the statements after the `:` run until the
// next `case`. Patterns are literals (numbers, characters, strings), enum
// variants — whose payload fields bind as names — or `_` for the catch-all.
// `match` is a statement, so each case returns or assigns its result.
// Conditions that need more than a literal (ranges, comparisons, fields of a
// struct) are written with if/else; range patterns (`case 10..99:`) are part
// of the 1.0 language.

// --- Enum matching ---

enum Shape : int32 {
    Circle = 0
    Rectangle = 1
    Triangle = 2
}

func shape_name(Shape s) -> str {
    match (s) {
        case Shape.Circle: return "circle"
        case Shape.Rectangle: return "rectangle"
        case Shape.Triangle: return "triangle"
    }
    return "unreachable"
}

// --- Match with associated data ---

// Variants can carry a payload. (Generic enums such as Result[T] are part of
// the 1.0 language, so this one carries an int32.)
enum IntResult : int32 {
    Ok(int32)
    Err(str)
}

func describe_result(IntResult r) -> str {
    match (r) {
        case IntResult.Ok(value): return "Success: {value}"
        case IntResult.Err(msg): return "Error: {msg}"
    }
    return "unreachable"
}

// --- Literal cases, then conditions ---

func classify(int32 n) -> str {
    match (n) {
        case 0: return "zero"
        case _:
            if (n > 0 && n < 10) {
                return "small positive"
            } else if (n >= 10 && n < 100) {
                return "medium positive"
            } else if (n >= 100) {
                return "large positive"
            }
            return "negative"
    }
    return "unreachable"
}

// --- Inspecting a struct ---

struct Point {
    float64 x
    float64 y
}

func quadrant(Point p) -> str {
    if (p.x == 0.0 && p.y == 0.0) {
        return "origin"
    } else if (p.x > 0.0 && p.y > 0.0) {
        return "quadrant I"
    } else if (p.x < 0.0 && p.y > 0.0) {
        return "quadrant II"
    } else if (p.x < 0.0 && p.y < 0.0) {
        return "quadrant III"
    } else if (p.x > 0.0 && p.y < 0.0) {
        return "quadrant IV"
    }
    return "on an axis"
}

// --- Matching a bool ---

func abs(int32 n) -> int32 {
    match (n >= 0) {
        case true: return n
        case false: return 0 - n
    }
    return 0
}

// --- Exhaustiveness checking ---

enum Color : int32 {
    Red = 0
    Green = 1
    Blue = 2
}

// Compiler ensures all cases are handled — no default needed. Leaving out a
// variant is a compile error ("match is not exhaustive").
func to_hex(Color c) -> str {
    match (c) {
        case Color.Red: return "#FF0000"
        case Color.Green: return "#00FF00"
        case Color.Blue: return "#0000FF"
    }
    return "unreachable"
}

// --- Several patterns with one result ---

func is_vowel(int32 ch) -> bool {
    match (ch) {
        case 'a': return true
        case 'e': return true
        case 'i': return true
        case 'o': return true
        case 'u': return true
        case 'A': return true
        case 'E': return true
        case 'I': return true
        case 'O': return true
        case 'U': return true
        case _: return false
    }
    return false
}

// --- Matching strings ---

func command(str word) -> str {
    match (word) {
        case "start": return "starting"
        case "stop": return "stopping"
        case _: return "unknown command '{word}'"
    }
    return "unreachable"
}

func main() -> int32 {
    // Enum matching
    println(shape_name(Shape.Circle))
    println(shape_name(Shape.Triangle))

    // Payloads
    println(describe_result(IntResult.Ok(42)))
    println(describe_result(IntResult.Err("disk full")))

    // Literal cases and conditions
    println(classify(0))
    println(classify(5))
    println(classify(42))
    println(classify(0 - 7))

    // Struct inspection
    Point p = Point { x: 3.0, y: -2.0 }
    println("Point is in {quadrant(p)}")

    // Matching a bool
    println("abs(-5) = {abs(0 - 5)}")

    // Exhaustive
    println("Red = {to_hex(Color.Red)}")

    // Several patterns, one result
    str word = "Stenopos"
    int32 vowels = 0
    for (i in 0..<word.len()) {
        if (is_vowel(word.byte_at(i))) {
            vowels += 1
        }
    }
    println("{word} has {vowels} vowels")

    println(command("start"))
    println(command("jump"))

    return 0
}
