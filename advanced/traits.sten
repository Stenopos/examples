// Example: Traits
// Demonstrates: trait definition, impl blocks, default methods, trait objects,
// trait bounds
//
// A trait lists methods; `impl Trait for Type` provides them. A trait may give
// a method a default body that implementations can override. `dyn Trait`
// holds any value whose type implements the trait. Static trait methods
// (`Self` constructors) and trait inheritance (`trait Drawable : Shape`) are
// not part of the language yet.

// Basic trait
trait Shape {
    func area() -> float64
    func perimeter() -> float64

    // Default implementation
    func describe() -> str {
        return "Shape with area {this.area()} and perimeter {this.perimeter()}"
    }
}

struct Circle {
    float64 radius
}

struct Rectangle {
    float64 width
    float64 height
}

impl Shape for Circle {
    func area() -> float64 {
        return 3.14159 * this.radius * this.radius
    }

    func perimeter() -> float64 {
        return 2.0 * 3.14159 * this.radius
    }
}

impl Shape for Rectangle {
    func area() -> float64 {
        return this.width * this.height
    }

    func perimeter() -> float64 {
        return 2.0 * (this.width + this.height)
    }

    // Override default
    func describe() -> str {
        return "Rectangle {this.width}x{this.height}"
    }
}

// Multiple traits
trait Serializable {
    func serialize() -> str
}

impl Serializable for Circle {
    func serialize() -> str {
        return "circle:{this.radius}"
    }
}

// Trait object as parameter type
func print_area(dyn Shape s) -> void {
    println("Area: {s.area()}")
}

// Trait bound in generics
func largest_area[T: Shape](List[T] shapes) -> float64 {
    float64 max = 0.0
    for (shape in shapes) {
        float64 a = shape.area()
        if (a > max) {
            max = a
        }
    }
    return max
}

func main() -> int32 {
    Circle c = Circle { radius: 5.0 }
    Rectangle r = Rectangle { width: 4.0, height: 6.0 }

    // Default method
    println(c.describe())
    // Overridden method
    println(r.describe())

    // Trait objects
    dyn Shape dc = c
    dyn Shape dr = r
    print_area(dc)
    print_area(dr)

    // Trait bound
    List[Rectangle] rects = list_new()
    rects.push(r)
    rects.push(Rectangle { width: 10.0, height: 1.5 })
    println("Largest rectangle area: {largest_area(rects)}")

    // Serialization
    println(c.serialize())

    return 0
}
