// Example: Type Aliases
// Demonstrates: type keyword, readable aliases, generic aliases, function-type
// aliases
//
// An alias is a second name for a type, and is transparent: a `UserId` is a
// `uint64`, so the two mix freely. (When two quantities must NOT mix, use a
// one-field struct instead.)

// Simple type aliases for readability
type UserId = uint64
type Score = float64
type Name = str

// Alias for complex types
type StringMap = HashMap[str, str]
type Callback = fn(int32) -> bool
type Scores = List[Score]

// Alias with generics
type Index[V] = HashMap[str, V]
type Optional[T] = T?

// Using aliases in function signatures
func get_user_name(UserId id) -> Name {
    return "User_{id}"
}

func calculate_score(List[int32] values) -> Score {
    int32 sum = 0
    for (v in values) {
        sum += v
    }
    return cast[float64](sum) / cast[float64](values.len())
}

func count_matching(List[int32] values, Callback keep) -> int32 {
    int32 n = 0
    for (v in values) {
        if (keep(v)) {
            n += 1
        }
    }
    return n
}

func lookup(Index[UserId] ids, Name name) -> Optional[UserId] {
    if (ids.contains(name)) {
        return ids.get(name)
    }
    return null
}

func main() -> int32 {
    UserId id = 42
    Name name = get_user_name(id)
    println("User: {name}")

    Score avg = calculate_score([85, 92, 78, 95])
    println("Average: {avg}")

    // Type alias is fully interchangeable with the original type
    uint64 raw_id = id  // No cast needed — same type
    println("Raw ID: {raw_id}")

    Callback is_even = |int32 v| -> bool {
        return v % 2 == 0
    }
    println("Even: {count_matching([1, 2, 3, 4, 6], is_even)}")

    Index[UserId] ids = map_new()
    ids.insert("ada", 7)
    println("ada: {lookup(ids, "ada") ?? 0}, bob: {lookup(ids, "bob") ?? 0}")

    StringMap env = map_new()
    env.insert("HOME", "/home/ada")
    println("HOME={env.get("HOME")}")
    return 0
}
