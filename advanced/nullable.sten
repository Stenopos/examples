// Example: Nullable Types (Kotlin-style Null Safety)
// Demonstrates: T? syntax, null checks, safe calls, the ?? default operator,
// non-null assertion
//
// A `T?` holds a value or `null`, and the compiler will not let you use it as
// a `T` until you have ruled out null. After a check the value is narrowed to
// the non-nullable type.

// Nullable type — T? means "T or null"
func find_user(str name) -> str? {
    if (name == "alice") {
        return "Alice Anderson"
    }
    return null
}

// Non-nullable parameter — compiler guarantees not null
func greet(str name) -> void {
    println("Hello, {name}!")
}

// Working with nullable values
func process_user(str username) -> void {
    str? user = find_user(username)

    // Null check — narrowed to non-null inside the block
    if (user != null) {
        // 'user' is now str (non-null) inside this block
        greet(user)
        println("Name length: {user.len()}")
    } else {
        println("User not found: {username}")
    }
}

// Nullable fields in structs
struct Profile {
    str name
    str? email
    int32? age
}

func display_profile(Profile p) -> void {
    println("Name: {p.name}")

    // ?? — default value if null
    str email = p.email ?? "no email"
    println("Email: {email}")

    int32? age = p.age
    if (age != null) {
        println("Age: {age}")
    } else {
        println("Age: not given")
    }
}

// Nullable with collections
func first_positive(List[int32] numbers) -> int32? {
    for (n in numbers) {
        if (n > 0) {
            int32? found = n
            return found
        }
    }
    return null
}

// Chaining nullable operations
struct Employee {
    str name
    str? email
}

struct Department {
    str name
    Employee? lead
}

struct Company {
    str name
    Department? engineering
}

func get_lead_email(Company company) -> str? {
    // Each ?. short-circuits to null if the receiver is null
    return company.engineering?.lead?.email
}

// Non-null assertion (use sparingly — aborts if null)
func must_find(str name) -> str {
    str? result = find_user(name)
    return result!!  // Aborts with "unexpected null" if result is null
}

func main() -> int32 {
    // Basic nullable
    str? found = find_user("alice")
    str? missing = find_user("bob")
    println("Found: {found ?? "nobody"}")
    println("Missing: {missing ?? "nobody"}")

    // Narrowing after a null check
    process_user("alice")
    process_user("bob")

    // Nullable struct fields
    str? alice_email = "alice@example.com"
    Profile p = Profile { name: "Alice", email: alice_email, age: null }
    display_profile(p)

    // Nullable results from collections
    List[int32] nums = [-3, -1, 0, 4, 2]
    int32? first = first_positive(nums)
    println("First positive: {first ?? 0}")

    // Chained nullable access
    str? bob_email = "bob@acme.com"
    Employee? bob = Employee { name: "Bob", email: bob_email }
    Department? eng = Department { name: "Engineering", lead: bob }
    Company co = Company { name: "Acme", engineering: eng }
    str? email = get_lead_email(co)
    println("Lead email: {email ?? "unknown"}")

    Company empty = Company { name: "Startup", engineering: null }
    println("Startup lead email: {get_lead_email(empty) ?? "unknown"}")

    println("Must find: {must_find("alice")}")
    return 0
}
