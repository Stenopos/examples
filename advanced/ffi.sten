// Example: Foreign Function Interface (FFI)
// Demonstrates: extern "C", typed pointers, str to C, a struct by value,
// a struct by pointer, and a callback (qsort's comparator).
//
// Everything that touches a pointer or calls C is inside `unsafe`: those
// blocks are the whole list of places to audit (ADR-0041).

// C's ldiv_t: a struct C returns by value.
@repr("C")
struct LDiv {
    int64 quot
    int64 rem
}

// A C-layout struct, copied by memcpy through pointers to it.
@repr("C")
struct CPoint {
    float64 x
    float64 y
}

extern "C" {
    func strlen(str s) -> uint64
    func malloc(uint64 size) -> ptr[void]
    func free(ptr[void] p) -> void
    func memcpy(ptr[void] dst, ptr[void] src, uint64 n) -> ptr[void]
    func qsort(ptr[int32] base, uint64 n, uint64 size, fn(ptr[int32], ptr[int32]) -> int32 compare) -> void
    func ldiv(int64 num, int64 den) -> LDiv
}

// Wrapping C calls in safe Stenopos functions.
func c_strlen(str s) -> uint64 {
    uint64 n = 0
    unsafe {
        n = strlen(s)                // C gets a NUL-terminated copy of s
    }
    return n
}

// The comparator qsort calls: a plain function, passed by name.
func compare_ints(ptr[int32] a, ptr[int32] b) -> int32 {
    int32 x = 0
    int32 y = 0
    unsafe {
        x = *a
        y = *b
    }
    if (x < y) {
        return 0 - 1
    }
    if (x > y) {
        return 1
    }
    return 0
}

// The element `i` of an int32 array starting at `base`.
func at(ptr[int32] base, int32 i) -> ptr[int32] {
    ptr[int32] p = base
    unsafe {
        p = cast[ptr[int32]](cast[uint64](base) + cast[uint64](i * 4))
    }
    return p
}

func main() -> int32 {
    println("strlen: {c_strlen("Stenopos FFI")}")

    LDiv d = LDiv { quot: 0, rem: 0 }
    unsafe {
        d = ldiv(cast[int64](1234567), 1000)
    }
    println("ldiv: {d.quot} rem {d.rem}")

    CPoint a = CPoint { x: 3.0, y: 4.0 }
    CPoint b = CPoint { x: 0.0, y: 0.0 }
    unsafe {
        discard memcpy(&b, &a, 16)
    }
    println("copied: {b.x} {b.y}")

    str sorted = ""
    unsafe {
        ptr[int32] xs = cast[ptr[int32]](malloc(20))
        if (xs == cast[ptr[int32]](0)) {
            fail("allocation failed")
        }
        int32 i = 0
        while (i < 5) {
            *at(xs, i) = (i * 7) % 5
            i = i + 1
        }
        qsort(xs, 5, 4, compare_ints)
        i = 0
        while (i < 5) {
            sorted = sorted + " {*at(xs, i)}"
            i = i + 1
        }
        free(xs)
    }
    println("sorted:" + sorted)
    return 0
}
