// Example: Cross-Platform CLI Application
// Demonstrates: modules, error handling, string processing, match, enums, traits
//
// Usage: cli_app <input> [-o output] [--format text|json|csv] [-v]
//
// Reads a text file and prints (or writes) its lines as plain text, a JSON
// array or CSV. Calling a method with arguments through `dyn Formatter` is
// part of the 1.0 language, so the formatter is chosen with a match.

import std.string.{split, join}
import std.os.{args}

enum OutputFormat : int32 {
    Text = 0
    Json = 1
    Csv = 2
}

struct Config {
    str input_path
    str output_path
    OutputFormat format
    bool verbose
}

trait Formatter {
    func format(List[str] lines) -> str
}

struct TextFormatter {
    str separator
}

struct JsonFormatter {
    int32 indent
}

struct CsvFormatter {
    str header
}

impl Formatter for TextFormatter {
    func format(List[str] lines) -> str {
        return join(lines, this.separator)
    }
}

impl Formatter for JsonFormatter {
    func format(List[str] lines) -> str {
        str pad = ""
        for (i in 0..<this.indent) {
            pad += " "
        }
        str result = "[\n"
        for (i, line in lines) {
            result += "{pad}\"{line}\""
            if (cast[int64](i) < lines.len() - 1) {
                result += ","
            }
            result += "\n"
        }
        result += "]"
        return result
    }
}

impl Formatter for CsvFormatter {
    func format(List[str] lines) -> str {
        str result = this.header + "\n"
        for (i, line in lines) {
            result += "{i + 1},\"{line}\"\n"
        }
        return result
    }
}

func parse_args(List[str] argv) -> Config {
    Config config = Config {
        input_path: "",
        output_path: "",
        format: OutputFormat.Text,
        verbose: false
    }

    int64 i = 0
    while (i < argv.len()) {
        match (argv.get(i)) {
            case "-o":
                i += 1
                config.output_path = argv.get(i)
            case "--format":
                i += 1
                match (argv.get(i)) {
                    case "json": config.format = OutputFormat.Json
                    case "csv": config.format = OutputFormat.Csv
                    case _: config.format = OutputFormat.Text
                }
            case "-v":
                config.verbose = true
            case _:
                config.input_path = argv.get(i)
        }
        i += 1
    }

    return config
}

// Drop the empty piece that a trailing newline leaves at the end
func split_lines(str content) -> List[str] {
    List[str] lines = split(content, "\n")
    if (lines.len() > 0 && lines.last() == "") {
        discard lines.pop()
    }
    return lines
}

@cap(File)
func read_input(str path) -> str {
    str content = read_file(path)
    if (content.len() == 0) {
        throw("IOError: cannot read {path}")
    }
    return content
}

@cap(File)
func main() -> int32 {
    Config config = parse_args(args())

    if (config.input_path == "") {
        eprintln("Usage: tool <input> [-o output] [--format text|json|csv] [-v]")
        return 1
    }

    try {
        str content = read_input(config.input_path)
        List[str] lines = split_lines(content)

        if (config.verbose) {
            println("Read {lines.len()} lines from {config.input_path}")
        }

        // Select formatter based on output format
        str output = ""
        match (config.format) {
            case OutputFormat.Json:
                JsonFormatter f = JsonFormatter { indent: 2 }
                output = f.format(lines)
            case OutputFormat.Csv:
                CsvFormatter f = CsvFormatter { header: "line_number,content" }
                output = f.format(lines)
            case _:
                TextFormatter f = TextFormatter { separator: "\n" }
                output = f.format(lines)
        }

        if (config.output_path != "") {
            discard write_file(config.output_path, output)
            println("Written to {config.output_path}")
        } else {
            println(output)
        }
    } catch (Error e) {
        eprintln("Error: {e}")
        return 1
    }

    return 0
}
