// Example: HTTP Web Server
// Demonstrates: std.net TCP sockets, std.http request/response, capabilities.
//
// A real HTTP server in Stenopos, in ~30 lines. Build and run it, then in another
// terminal:  curl localhost:8080/   |   curl localhost:8080/health
//
// The network is a capability: every function that touches a socket declares
// @cap(Network), so `main`'s use of the network is visible in its type — the
// compiler will not let a function open a socket without saying so.

import std.net.{Listener, Conn, listen, accept, recv, send, close, shutdown}
import std.http.{Request, parse_request, response}

// Route a request path to a response. Pure string work (no @cap needed): it
// only builds responses, it does not touch the network itself.
func route(str path) -> str {
    if (path == "/") {
        return response(200, "Welcome to Stenopos!")
    }
    if (path == "/health") {
        return response(200, "OK")
    }
    return response(404, "Not Found")
}

@cap(Network)
func main() -> void {
    Listener l = listen(8080)
    if (l.fd < 0) {
        println("bind failed — is port 8080 already in use?")
        return
    }
    println("Stenopos web server listening on http://localhost:8080")

    // Accept and serve one connection at a time (Ctrl-C to stop). Each: read the
    // request, route on its path, write the response, close the connection.
    for (n in 0..1000000) {
        Conn c = accept(l)
        if (c.fd < 0) {
            continue
        }
        str raw = recv(c)
        Request req = parse_request(raw)
        str resp = route(req.path)
        discard send(c, resp)
        discard close(c)
    }
    discard shutdown(l)
}
