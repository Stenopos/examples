// Classes — inheritance, override, abstract-style base classes, and visibility
//
// Classes are values with inheritance: parent classes are named with `:`,
// methods reach the receiver through `this` (no explicit `self` parameter),
// and `parent.method()` calls up the chain. Fields and methods are private by
// default; `pub` exposes them.
//
// `abstract` classes and methods are part of the 1.0 language; until then the
// Shape base class gives `area` a virtual default that every subclass
// overrides.

class Animal {
    pub str name
    int64 age

    virtual func speak() -> void {
        println("generic animal sound")
    }

    pub func describe() -> void {
        println("I am {this.name}")
    }
}

class Dog : Animal {
    str breed

    override func speak() -> void {
        parent.speak()
        println("Woof!")
    }

    pub func fetch() -> void {
        println("Fetching ball...")
    }
}

class Cat : Animal {
    bool indoor

    override func speak() -> void {
        println("Meow!")
    }

    pub func purr() -> void {
        println("Purring...")
    }
}

class Shape {
    virtual func area() -> float64 {
        return 0.0
    }
}

class Rectangle : Shape {
    float64 width
    float64 height

    override func area() -> float64 {
        return this.width * this.height
    }
}

class Counter {
    int64 count
    pub str name

    pub func increment() -> void {
        this.count += 1
    }

    pub func get_count() -> int64 {
        return this.count
    }

    func reset() -> void {
        this.count = 0
    }
}

func main() -> void {
    Dog d = Dog { name: "Rex", age: 3, breed: "collie" }
    d.describe()
    d.speak()
    d.fetch()

    Cat c = Cat { name: "Tom", age: 5, indoor: true }
    c.describe()
    c.speak()
    c.purr()

    // Polymorphism goes through `dyn`
    Rectangle r = Rectangle { width: 3.0, height: 4.0 }
    dyn Shape s = r
    println("area = {s.area()}")

    Counter k = Counter { count: 0, name: "clicks" }
    k.increment()
    k.increment()
    println("{k.name}: {k.get_count()}")

    println("Classes demonstration complete")
}
