// Example: Semaphore
// Demonstrates: a counting semaphore limiting how many Hemerodromes run a
// critical section at once
//
// `semaphore(n)` starts with n permits. `acquire()` blocks until a permit is
// available, `release()` returns one, and `try_acquire()` takes one only if
// it can do so without waiting.

func query_database(semaphore db_pool, atomic[int32] active, atomic[int32] peak, semaphore done) -> void {
    // acquire() blocks until a permit is available
    db_pool.acquire()

    int32 now = active.fetch_add(1) + 1
    // record the highest number of queries running at once
    int32 seen = peak.load()
    while (now > seen && !peak.compare_exchange(seen, now)) {
        seen = peak.load()
    }
    // ... do database work here ...
    discard active.fetch_sub(1)

    // release() returns the permit for the next waiter
    db_pool.release()
    done.release()
}

func main() -> void {
    println("--- Semaphore demo: max 3 concurrent DB connections ---")

    // Only 3 Hemerodromes may enter the database pool at once
    semaphore db_pool = semaphore(3)
    atomic[int32] active = atomic(0)
    atomic[int32] peak = atomic(0)
    semaphore done = semaphore(0)

    // 8 Hemerodromes competing for 3 slots
    for (i in 0..<8) {
        spawn query_database(db_pool, active, peak, done)
    }
    for (i in 0..<8) {
        done.acquire()
    }
    bool within_limit = peak.load() <= 3
    println("All queries complete; never more than 3 at once: {within_limit}")

    // try_acquire never blocks
    semaphore single = semaphore(1)
    println("first try_acquire: {single.try_acquire()}")
    println("second try_acquire: {single.try_acquire()}")
    single.release()
    println("after release: {single.try_acquire()}")
}
