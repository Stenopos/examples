// Example: Atomic Types
// Demonstrates: atomic[T] load/store/fetch_add/compare_exchange for lock-free
// shared state
//
// An atomic[T] is a shared cell: passing it to `spawn` shares the same cell
// across Hemerodromes, not a copy. fetch_* and swap return the value held
// before the operation; compare_exchange writes only if the current value
// matches the expected one and reports whether it did.

func increment_worker(atomic[int64] counter, int32 iterations, semaphore done) -> void {
    for (i in 0..<iterations) {
        discard counter.fetch_add(1)
    }
    done.release()
}

func demo_basic_ops() -> void {
    println("--- Basic atomic operations ---")
    atomic[int64] val = atomic(0)

    // Store a value
    val.store(42)

    // Load the value
    int64 v = val.load()
    println("Stored and loaded: {v}")

    // Fetch-and-add: returns the old value
    int64 old = val.fetch_add(10)
    println("fetch_add(10): old={old}, new={val.load()}")

    // Compare-and-swap: only writes if current value matches expected
    bool swapped = val.compare_exchange(52, 100)
    println("compare_exchange(52, 100): swapped={swapped}, val={val.load()}")
    bool again = val.compare_exchange(52, 7)
    println("compare_exchange(52, 7): swapped={again}, val={val.load()}")
}

func demo_concurrent_counter() -> void {
    println("--- Concurrent counter ---")
    // Shared counter — atomic so there is no data race across Hemerodromes
    atomic[int64] counter = atomic(0)
    semaphore done = semaphore(0)

    for (i in 0..<4) {
        spawn increment_worker(counter, 250, done)
    }
    // Wait for all four workers
    for (i in 0..<4) {
        done.acquire()
    }

    // 4 Hemerodromes * 250 iterations = 1000 (no races thanks to atomics)
    println("Final counter: {counter.load()} (expected 1000)")
}

func main() -> void {
    demo_basic_ops()
    demo_concurrent_counter()
}
