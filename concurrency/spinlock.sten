// Example: Spinlock
// Demonstrates: spinlock[T] for ultra-short critical sections, busy-waits
// instead of sleeping
//
// A spinlock is for data that is held for only a handful of instructions.
// It busy-waits (spins) instead of parking — no scheduler round trip. Wrong
// choice for long-held locks; right choice for tiny counters.

func spin_increment(spinlock[int64] hot_counter, int32 times, semaphore done) -> void {
    for (i in 0..<times) {
        // Lock is held for one add — ideal for a spinlock
        with (g = hot_counter.guard()) {
            g.set(g.get() + 1)
        }
    }
    done.release()
}

func main() -> void {
    println("--- Spinlock demo ---")
    spinlock[int64] hot_counter = spinlock(0)
    semaphore done = semaphore(0)

    for (i in 0..<4) {
        spawn spin_increment(hot_counter, 250, done)
    }
    for (i in 0..<4) {
        done.acquire()
    }

    with (g = hot_counter.guard()) {
        println("Final value: {g.get()} (expected 1000)")
    }
}
