// Example: RwLock (Reader-Writer Lock)
// Demonstrates: rwlock[T] allowing many readers or one writer at a time
//
// `read_guard()` takes the shared read lock — many readers may hold it at
// once. `guard()` takes the exclusive write lock. Both are released at the end
// of their `with` block.

struct Config {
    str host
    int32 port
    bool debug
}

func reader(rwlock[Config] config, chan[int32] seen) -> void {
    // read_guard() acquires a shared read lock — multiple readers allowed
    with (r = config.read_guard()) {
        seen.send(r.get().port)
    }
}

func writer(rwlock[Config] config, semaphore done) -> void {
    // guard() acquires the exclusive write lock — blocks all readers
    with (w = config.guard()) {
        Config c = w.get()
        c.port = 9090
        c.debug = true
        w.set(c)
    }
    done.release()
}

func main() -> void {
    println("--- RwLock demo ---")
    rwlock[Config] config = rwlock(Config { host: "localhost", port: 8080, debug: false })

    // Several readers can run at the same time; each sees a whole config
    chan[int32] seen = chan()
    for (i in 0..<3) {
        spawn reader(config, seen)
    }
    for (i in 0..<3) {
        int32 port = seen.recv()
        if (port != 8080 && port != 9090) {
            println("torn read: {port}")
        }
    }
    println("3 readers saw a consistent config")

    // One writer — waits until no reader holds the lock
    semaphore done = semaphore(0)
    spawn writer(config, done)
    done.acquire()

    // Read back the updated config
    with (r = config.read_guard()) {
        Config c = r.get()
        println("Final config: host={c.host} port={c.port} debug={c.debug}")
    }
}
