// Factorial — recursive and const versions
//
// `const func` (a function evaluated at compile time) is part of the 1.0
// language and is not implemented yet; see KNOWN_ISSUES.md.

const func factorial(int32 n) -> int32 {
    if (n <= 1) {
        return 1
    }
    return n * factorial(n - 1)
}

func main() -> int32 {
    for (i in 1..10) {
        println("{i}! = {factorial(i)}")
    }

    // Evaluated at compile time because all args are const
    const int32 F10 = factorial(10)
    println("10! at compile time = {F10}")

    return 0
}
