// Types — demonstrates basic type declarations and usage

func get_int() -> int32 {
    return 42
}

func get_float() -> float64 {
    return 3.14
}

func get_bool() -> bool {
    return true
}

func main() -> void {
    int32 a = get_int()
    float64 b = get_float()
    bool c = get_bool()
    int64 big = 5000000000
    uint32 flags = 0b1010
    uint64 mask = 0xffff_0000
    str s = "Stenopos"

    println("int32 = {a}, float64 = {b}, bool = {c}")
    println("int64 = {big}, uint32 = {flags}, uint64 = {mask}, str = {s}")
    if (c) {
        println("Types demo complete")
    }
}
