// Math — basic arithmetic operations

func add(int32 a, int32 b) -> int32 {
    return a + b
}

func main() -> void {
    int32 x = 10
    int32 y = 20
    int32 z = add(x, y)
    println("{x} + {y} = {z}")
    println("{y} - {x} = {y - x}")
    println("{x} * {y} = {x * y}")
    println("{y} / {x} = {y / x}")
    println("{y} % 7 = {y % 7}")
    println("Math operations complete")
}
