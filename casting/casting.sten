// Casting — explicit numeric type conversions using cast[T]()
//
// There are no implicit numeric conversions: every change of type is written
// out with cast[T](). cast converts between the integer and float types; a
// bool is not a number, so it is turned into one with an ordinary branch.

func main() -> void {
    // Safe cast: int32 to int64 (widening)
    int32 x = 42
    int64 y = cast[int64](x)
    println("int32 {x} -> int64 {y}")

    // Safe cast: float64 to int32 (truncating)
    float64 pi = 3.14
    int32 rounded = cast[int32](pi)
    println("float64 {pi} -> int32 {rounded}")

    // bool to int32: not a numeric conversion, so no cast
    bool flag = true
    int32 as_int = 0
    if (flag) {
        as_int = 1
    }
    println("bool {flag} -> int32 {as_int}")

    // Safe cast: int32 to float64
    int32 count = 100
    float64 as_float = cast[float64](count)
    println("int32 {count} -> float64 {as_float}")

    // Cast in expressions
    int32 a = 10
    int64 b = cast[int64](a) + 20
    println("cast[int64](10) + 20 = {b}")

    // Multiple casts in chain
    int32 small = 7
    int64 medium = cast[int64](small)
    float64 big = cast[float64](medium)
    println("int32 {small} -> int64 {medium} -> float64 {big}")

    // Cast with arithmetic
    int32 m = 5
    int32 n = 3
    float64 ratio = cast[float64](m) / cast[float64](n)
    println("{m} / {n} as float64 = {ratio}")

    // Signed and unsigned: widening sign-extends a signed value and
    // zero-extends an unsigned one
    int32 neg = 0 - 1
    uint32 top = 4294967295
    println("int32 -1 -> int64 {cast[int64](neg)}, uint32 max -> int64 {cast[int64](top)}")

    println("Casting demo complete")
}
