// Breadth-first search over a hardcoded undirected graph. Nested
// List[List[int32]] isn't supported yet (see note below), so the adjacency
// list is List[Row] where Row wraps a List[int32] — still a real nested
// heap collection (List inside a struct inside a List). Queue is a
// List[int32] used as a FIFO via an index-based front pointer.
struct Row {
    List[int32] neighbors
}

func main() -> void {
    // 6 nodes, undirected edges:
    // 0-1, 0-2, 1-3, 1-4, 2-4, 3-5, 4-5
    List[Row] graph = list_new()

    List[int32] n0 = list_new()
    n0.push(1)
    n0.push(2)
    graph.push(Row { neighbors: n0 })

    List[int32] n1 = list_new()
    n1.push(0)
    n1.push(3)
    n1.push(4)
    graph.push(Row { neighbors: n1 })

    List[int32] n2 = list_new()
    n2.push(0)
    n2.push(4)
    graph.push(Row { neighbors: n2 })

    List[int32] n3 = list_new()
    n3.push(1)
    n3.push(5)
    graph.push(Row { neighbors: n3 })

    List[int32] n4 = list_new()
    n4.push(1)
    n4.push(2)
    n4.push(5)
    graph.push(Row { neighbors: n4 })

    List[int32] n5 = list_new()
    n5.push(3)
    n5.push(4)
    graph.push(Row { neighbors: n5 })

    int32 node_count = cast[int32](graph.len())
    int32 source = 0

    List[bool] visited = list_new()
    List[int32] dist = list_new()
    for (i in 0..node_count) {
        visited.push(false)
        dist.push(-1)
    }

    List[int32] queue = list_new()
    queue.push(source)
    visited.set(source, true)
    dist.set(source, 0)

    int64 front = 0
    List[int32] order = list_new()

    while (front < queue.len()) {
        int32 cur = queue.get(front)
        front += 1
        order.push(cur)

        Row row = graph.get(cur)
        List[int32] neighbors = row.neighbors
        for (nb in neighbors) {
            if (!visited.get(nb)) {
                visited.set(nb, true)
                int32 nd = dist.get(cur) + 1
                dist.set(nb, nd)
                queue.push(nb)
            }
        }
    }

    List[str] order_parts = list_new()
    int64 oi = 0
    while (oi < order.len()) {
        if (oi > 0) {
            order_parts.push(" ")
        }
        int32 ov = order.get(oi)
        order_parts.push("{ov}")
        oi += 1
    }
    println("BFS order: {order_parts.join()}")

    println("Distances from {source}:")
    for (i in 0..node_count) {
        println("  node {i}: {dist.get(i)}")
    }

    // Sanity check: every reachable node should have been visited exactly
    // once, so order.len() should equal node_count for a connected graph.
    println("visited {order.len()} of {node_count} nodes")
}
