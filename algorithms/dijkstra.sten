// Dijkstra's shortest path over a small hardcoded directed weighted graph.
// Edge weights are int64 and large enough that accumulated path totals
// exceed 2^31 (so this would silently corrupt if the compiler mishandled
// int64 storage/arithmetic in nested collections). No priority queue —
// plain O(V^2) linear-scan Dijkstra, the realistic choice for a graph this
// small. Nested List[List[...]] isn't supported yet (see matrix.sten /
// bfs.sten notes), so adjacency is List[Edges] where Edges wraps a
// List[int32] of targets and a List[int64] of weights.
struct Edges {
    List[int32] targets
    List[int64] weights
}

func main() -> void {
    // 5 nodes, directed edges (targets + weights per source node).
    // Weights are large enough that the shortest-path totals for nodes 3
    // and 4 exceed int32::MAX (2147483647) even though every individual
    // edge weight fits in an int32.
    // 0 -> 1 (1500000000), 0 -> 2 (1600000000)
    // 1 -> 2 (1400000000), 1 -> 3 (1800000000)
    // 2 -> 3 (1700000000), 2 -> 4 (1900000000)
    // 3 -> 4 (1600000000)
    List[Edges] adj = list_new()

    List[int32] t0 = list_new()
    t0.push(1)
    t0.push(2)
    List[int64] w0 = list_new()
    w0.push(1500000000)
    w0.push(1600000000)
    adj.push(Edges { targets: t0, weights: w0 })

    List[int32] t1 = list_new()
    t1.push(2)
    t1.push(3)
    List[int64] w1 = list_new()
    w1.push(1400000000)
    w1.push(1800000000)
    adj.push(Edges { targets: t1, weights: w1 })

    List[int32] t2 = list_new()
    t2.push(3)
    t2.push(4)
    List[int64] w2 = list_new()
    w2.push(1700000000)
    w2.push(1900000000)
    adj.push(Edges { targets: t2, weights: w2 })

    List[int32] t3 = list_new()
    t3.push(4)
    List[int64] w3 = list_new()
    w3.push(1600000000)
    adj.push(Edges { targets: t3, weights: w3 })

    List[int32] t4 = list_new()
    List[int64] w4 = list_new()
    adj.push(Edges { targets: t4, weights: w4 })

    int32 node_count = cast[int32](adj.len())
    int32 source = 0
    int64 infinity = 1000000000000

    List[int64] dist = list_new()
    List[bool] visited = list_new()
    for (i in 0..node_count) {
        dist.push(infinity)
        visited.push(false)
    }
    dist.set(source, 0)

    int32 processed = 0
    while (processed < node_count) {
        // Find the unvisited node with the smallest tentative distance.
        int32 u = -1
        int64 best = infinity
        for (i in 0..node_count) {
            if (!visited.get(i) && dist.get(i) <= best) {
                best = dist.get(i)
                u = i
            }
        }
        if (u == -1) {
            // Remaining nodes are unreachable; nothing left to relax.
            processed = node_count
        } else {
            visited.set(u, true)
            Edges e = adj.get(u)
            List[int32] targets = e.targets
            List[int64] weights = e.weights
            int64 n_edges = targets.len()
            int64 k = 0
            while (k < n_edges) {
                int32 v = targets.get(k)
                int64 w = weights.get(k)
                int64 cand = dist.get(u) + w
                if (cand < dist.get(v)) {
                    dist.set(v, cand)
                }
                k += 1
            }
            processed += 1
        }
    }

    println("Shortest distances from node {source}:")
    for (i in 0..node_count) {
        int64 d = dist.get(i)
        if (d >= infinity) {
            println("  node {i}: unreachable")
        } else {
            println("  node {i}: {d}")
        }
    }

    // dist[3] and dist[4] are each built from two/three summed edge
    // weights and land north of int32::MAX (2147483647) — confirms the
    // int64 distance survived the whole relax loop without truncation.
    int64 int32_max = 2147483647
    println("dist[3] exceeds int32::MAX: {dist.get(3) > int32_max}")
    println("dist[4] exceeds int32::MAX: {dist.get(4) > int32_max}")
}
