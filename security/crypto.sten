// Example: Crypto Safety (@sensitive)
// Demonstrates: @sensitive memory wiping, zeroing keys after use
//
// @sensitive on a variable tells the compiler:
//   1. Wipe the value's heap memory before it is freed, so the secret does not
//      linger in a freed allocation where a later heap read or a core dump
//      could recover it
//   2. Refuse to format the value into a string (no accidental logging)
//
// Byte buffers are `List[int32]` values in 0..255 (see std.bytes). Marking a
// struct field `@sensitive`, locking pages in memory (mlock/MADV_DONTDUMP),
// and a library `secure_zero` are not available yet; see KNOWN_ISSUES.md.

struct CryptoKey {
    List[int32] key_bytes
    int32 length
}

func load_key(str path) -> CryptoKey {
    // In real code: read from a hardware token or key file
    @sensitive List[int32] raw = [0xDE, 0xAD, 0xBE, 0xEF]
    return CryptoKey { key_bytes: raw, length: 4 }
}   // raw is wiped here automatically

func encrypt(CryptoKey key, List[int32] plaintext) -> List[int32] {
    // A placeholder cipher: XOR with the repeating key
    @sensitive List[int32] k = key.key_bytes
    List[int32] out = list_new()
    for (i, b in plaintext) {
        out.push(b ^ k.get(i % key.length))
    }
    return out
}   // k is wiped when it goes out of scope

// Zero a buffer in place, for an early wipe
func wipe(List[int32] buf) -> List[int32] {
    List[int32] out = buf
    for (i in 0..<out.len()) {
        out.set(i, 0)
    }
    return out
}

func demo_explicit_zero() -> void {
    // You can also zero early — useful before passing control to untrusted code
    @sensitive List[int32] password_buf = [0x70, 0x61, 0x73, 0x73]
    println("Password loaded ({password_buf.len()} bytes)")

    // println("{password_buf.get(0)}")   // ERROR: a @sensitive value may not be formatted

    // Explicit early wipe
    password_buf = wipe(password_buf)
    println("Password wiped from memory")
}   // @sensitive also wipes the buffer here — idempotent

func main() -> void {
    @sensitive CryptoKey key = load_key("/etc/app.key")
    List[int32] ciphertext = encrypt(key, [0x01, 0x02, 0x03])
    println("Ciphertext: {ciphertext.get(0)} {ciphertext.get(1)} {ciphertext.get(2)}")
    println("Encryption complete, key material wiped")

    demo_explicit_zero()
}
