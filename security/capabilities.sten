// Example: Capability Permissions
// Demonstrates: cap[Resource] tokens gate access to sensitive operations at
// the type level
//
// A `cap[R]` is an unforgeable, zero-cost token proving the right to a
// resource R (File, Network, Process, Memory, System). It is minted only by
// `grant[R]()` inside code that itself declares `@cap(R)`, and then handed
// explicitly to whoever needs the authority. A function that holds a token
// may use the resource without declaring `@cap` itself.

import std.string.{to_upper}

// Only a holder of a File token can call this
func read_secret(cap[File] perm, str path) -> str {
    // perm proves the caller was granted file access
    return "contents of {path}"
}

// Only a holder of a Network token can open sockets
func fetch_url(cap[Network] perm, str url) -> str {
    return "response from {url}"
}

// Capabilities can be passed down but not forged
func run_with_caps(cap[File] read_cap, cap[Network] net_cap) -> void {
    str data = read_secret(read_cap, "/etc/passwd")
    str resp = fetch_url(net_cap, "https://example.com")
    println("Got data ({data}) and response ({resp})")
}

// Sandboxed code that does not receive a token cannot do I/O at all.
func sandboxed_library(str data) -> str {
    // No cap parameters — this function cannot reach files or the network
    return to_upper(data)
}

// main is trusted with File and Network, so it may mint the tokens
@cap(File)
@cap(Network)
func main() -> void {
    cap[File] read_cap = grant[File]()
    cap[Network] net_cap = grant[Network]()

    run_with_caps(read_cap, net_cap)

    str result = sandboxed_library("hello")
    println("{result}")
}
