// Example: With Block (Resource Management)
// Demonstrates: with block acquiring and auto-releasing resources, even on error
//
// `with` works for locks today (see concurrency/mutex.sten). Holding a file
// with `with (File f = open(path)) { ... }` is part of the 1.0 language, so
// this example does not compile yet; see KNOWN_ISSUES.md.

// Any type with an open and a close works with with blocks.
// The block calls close at the end — even if an error is thrown.

@cap(File)
func read_one(str path) -> void {
    // File is opened here and closed automatically at the closing brace
    with (File f = open(path)) {
        str contents = f.read_all()
        println("Read {contents.len()} bytes")
    }
    // f has already been closed — no leak possible
}

@cap(File)
func write_one(str path, str data) -> void {
    with (File f = open(path)) {
        f.write(data)
    }
}

@cap(File)
func nested_resources() -> void {
    // Nested with blocks: opened outside in, closed inside out
    with (File src = open("/tmp/stenopos-with-input.txt")) {
        with (File dst = open("/tmp/stenopos-with-output.txt")) {
            str line = src.read_line()
            dst.write(line.trim())
        }
    }
}

@cap(File)
func main() -> void {
    write_one("/tmp/stenopos-with-input.txt", "hello with\n")
    try {
        read_one("/tmp/stenopos-with-input.txt")
    } catch (Error e) {
        println("Could not read: {e}")
    }

    nested_resources()
    println("with block demo complete")
}
