// Example: Try / Catch / Finally
// Demonstrates: try block, catch, finally always runs, rethrowing to an outer
// handler
//
// `throw("message")` raises an error and `catch (Error e)` receives it; `{e}`
// formats its message. Typed errors with several `catch` arms tried in order
// (`catch (IOError e)`, `catch (ParseError e)`, ...) and an `e.message` field
// are part of the 1.0 language, so this example tags each error's message
// with its kind instead.

import std.convert.{is_int, parse_int}

func parse_number(str s) -> int32 {
    if (!is_int(s)) {
        throw("ParseError: not a number: '{s}'")
    }
    return parse_int(s)
}

@cap(File)
func read_config(str path) -> str {
    str text = read_file(path)
    if (text.len() == 0) {
        throw("IoError: cannot read {path}")
    }
    return text.trim()
}

@cap(File)
func load_port(str path) -> void {
    try {
        str raw = read_config(path)
        int32 port = parse_number(raw)
        println("Port: {port}")
    } catch (Error e) {
        println("Config problem: {e}")
    } finally {
        // Runs whether an error was thrown or not
        println("Config load attempt finished")
    }
}

func demo_rethrow() -> void {
    try {
        discard parse_number("not-a-number")
    } catch (Error e) {
        println("Caught, logging, then rethrowing...")
        throw("{e}")
    }
}

@cap(File)
func main() -> void {
    // A good config, a missing file, and a config that is not a number
    discard write_file("/tmp/stenopos-example-port.conf", "8080\n")
    discard write_file("/tmp/stenopos-example-bad.conf", "eighty\n")
    load_port("/tmp/stenopos-example-port.conf")
    load_port("/tmp/stenopos-example-missing.conf")
    load_port("/tmp/stenopos-example-bad.conf")

    // Outer handler catches the rethrown error
    try {
        demo_rethrow()
    } catch (Error e) {
        println("Outer caught: {e}")
    }
}
